  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  admin    Admin?    @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([userId])
  @@index([adminId])
  @@index([actorType])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("activity_logs")
}

// =============================================================================
// AI
// =============================================================================

model AIUsageLog {
  id          String   @id @default(uuid()) @map("id")
  customerId  String   @map("customer_id")
  feature     String   @db.VarChar(200)
  model       String   @db.VarChar(100)
  inputTokens Int      @default(0) @map("input_tokens")
  outputTokens Int     @default(0) @map("output_tokens")
  latencyMs   Int?     @map("latency_ms")
  success     Boolean  @default(true) @map("success")
  errorMessage String? @map("error_message") @db.Text
  metadata    Json?    @map("metadata")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([feature])
  @@index([createdAt])
  @@map("ai_usage_logs")
}

model AIExplanation {
  id             String   @id @default(uuid()) @map("id")
  userId         String   @map("user_id")
  type           String   @db.VarChar(100)
  referenceId    String?  @map("reference_id") @db.VarChar(255)
  explanation    String   @db.Text
  language       String   @default("fr") @db.VarChar(5)
  generatedAt    DateTime @map("generated_at")
  expiresAt      DateTime? @map("expires_at")
  metadata       Json?    @map("metadata")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([referenceId])
  @@map("ai_explanations")
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

model Notification {
  id          String           @id @default(uuid()) @map("id")
  customerId  String           @map("customer_id")
  userId      String           @map("user_id")
  type        NotificationType @map("type")
  title       String           @db.VarChar(500)
  body        String           @db.Text
  data        Json?            @map("data")
  isRead      Boolean          @default(false) @map("is_read")
  readAt      DateTime?        @map("read_at")
  sentAt      DateTime?        @map("sent_at")
  channel     String?          @db.VarChar(50)
  metadata    Json?            @map("metadata")
  createdAt   DateTime         @default(now()) @map("created_at")

  // Relations
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, isRead])
  @@map("notifications")
}

// =============================================================================
// SETTINGS
// =============================================================================

model Setting {
  id          String   @id @default(uuid()) @map("id")
  customerId  String?  @map("customer_id")
  key         String   @db.VarChar(200)
  value       String   @db.Text
  type        String   @default("string") @db.VarChar(20)
  description String?  @db.Text
  isPublic    Boolean  @default(false) @map("is_public")
  metadata    Json?    @map("metadata")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, key])
  @@index([customerId])
  @@index([key])
  @@map("settings")
}
