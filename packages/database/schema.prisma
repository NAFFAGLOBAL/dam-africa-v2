// =============================================================================
// DAMFlotte CLD - Enterprise Fleet Management & Driver Credit Scoring Platform
// Prisma Schema - PostgreSQL
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
  BLACKLISTED
}

enum KYCStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  LOAN_OFFICER
  FINANCE
  SUPPORT
}

enum AdminStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DocumentType {
  NATIONAL_ID
  PASSPORT
  DRIVERS_LICENSE
  PROOF_OF_ADDRESS
  VEHICLE_REGISTRATION
  INSURANCE
  SELFIE
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum LoanStatus {
  DRAFT
  PENDING
  UNDER_REVIEW
  APPROVED
  DISBURSED
  ACTIVE
  COMPLETED
  DEFAULTED
  REJECTED
  CANCELLED
}

enum ScheduleStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  OVERDUE
  WAIVED
  CANCELLED
}

enum PaymentMethod {
  MOBILE_MONEY
  BANK_TRANSFER
  CASH
  CARD
  WALLET
  DEDUCTION
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentType {
  LOAN_REPAYMENT
  RENTAL_PAYMENT
  CONTRACT_PAYMENT
  DEPOSIT
  FEE
  PENALTY
  REFUND
  OTHER
}

enum VehicleStatus {
  AVAILABLE
  ASSIGNED
  IN_MAINTENANCE
  RESERVED
  DECOMMISSIONED
  STOLEN
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  LPG
}

enum RentalStatus {
  REQUESTED
  APPROVED
  ACTIVE
  SUSPENDED
  TERMINATED
  COMPLETED
  REJECTED
}

enum NotificationType {
  SYSTEM
  KYC_UPDATE
  LOAN_UPDATE
  PAYMENT_REMINDER
  PAYMENT_RECEIVED
  PAYMENT_OVERDUE
  VEHICLE_ALERT
  CREDIT_SCORE_UPDATE
  RENTAL_UPDATE
  CONTRACT_UPDATE
  ACCIDENT_UPDATE
  SUPPORT_UPDATE
  BADGE_EARNED
  GEOFENCE_ALERT
  MAINTENANCE_DUE
  PROMOTION
  GENERAL
}

enum ActorType {
  USER
  ADMIN
  SYSTEM
}

enum CustomerPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
  CUSTOM
}

enum CustomerStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  CANCELLED
}

enum ContractStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  PAUSED
  COMPLETED
  DEFAULTED
  TERMINATED
  CANCELLED
}

enum ContractPaymentStatus {
  SCHEDULED
  PAID
  PARTIALLY_PAID
  OVERDUE
  WAIVED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  REACHED
  CELEBRATED
}

enum AccidentSeverity {
  MINOR
  MODERATE
  SEVERE
  FATAL
}

enum AccidentStatus {
  REPORTED
  UNDER_INVESTIGATION
  RESOLVED
  CLOSED
  DISPUTED
}

enum AccidentMediaType {
  PHOTO
  VIDEO
  DOCUMENT
}

enum TelemetryEventType {
  POSITION
  OVERSPEED
  HARSH_BRAKING
  HARSH_ACCELERATION
  SHARP_TURN
  IDLE
  ENGINE_ON
  ENGINE_OFF
  SOS
}

enum GeofenceType {
  CIRCLE
  POLYGON
}

enum GeofenceAlertType {
  ENTRY
  EXIT
  DWELL
}

enum IncomeSource {
  YANGO
  UBER
  BOLT
  MANUAL
  OTHER
}

enum TicketCategory {
  VEHICLE_ISSUE
  PAYMENT_ISSUE
  LOAN_INQUIRY
  KYC_HELP
  APP_BUG
  ACCOUNT_ISSUE
  CONTRACT_ISSUE
  ACCIDENT
  GENERAL
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  WAITING_ON_AGENT
  RESOLVED
  CLOSED
}

enum SenderType {
  USER
  ADMIN
  SYSTEM
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum EmailDigest {
  NONE
  DAILY
  WEEKLY
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum MaintenanceType {
  SCHEDULED
  UNSCHEDULED
  REPAIR
  INSPECTION
  TIRE_CHANGE
  OIL_CHANGE
  OTHER
}

// =============================================================================
// MULTI-TENANT: CUSTOMER (TENANT)
// =============================================================================

model Customer {
  id          String         @id @default(uuid()) @map("id")
  name        String         @db.VarChar(200)
  slug        String         @unique @db.VarChar(100)
  email       String         @unique @db.VarChar(255)
  phone       String?        @db.VarChar(30)
  logoUrl     String?        @map("logo_url") @db.Text
  primaryColor String?       @map("primary_color") @db.VarChar(7)
  secondaryColor String?     @map("secondary_color") @db.VarChar(7)
  plan        CustomerPlan   @default(STARTER) @map("plan")
  status      CustomerStatus @default(TRIAL) @map("status")
  maxDrivers  Int            @default(50) @map("max_drivers")
  maxVehicles Int            @default(50) @map("max_vehicles")
  maxAdmins   Int            @default(5) @map("max_admins")
  trialEndsAt DateTime?      @map("trial_ends_at")
  domain      String?        @db.VarChar(255)
  timezone    String         @default("Africa/Abidjan") @db.VarChar(50)
  currency    String         @default("XOF") @db.VarChar(3)
  country     String         @default("CI") @db.VarChar(2)
  metadata    Json?          @map("metadata")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  // Relations
  users                  User[]
  admins                 Admin[]
  vehicles               Vehicle[]
  loans                  Loan[]
  payments               Payment[]
  kycDocuments           KYCDocument[]
  vehicleRentals         VehicleRental[]
  rentToOwnContracts     RentToOwnContract[]
  accidentReports        AccidentReport[]
  geofenceZones          GeofenceZone[]
  supportTickets         SupportTicket[]
  creditScoreHistories   CreditScoreHistory[]
  scoringConfigs         ScoringConfig[]
  badgeDefinitions       BadgeDefinition[]
  incomeRecords          IncomeRecord[]
  notifications          Notification[]
  activityLogs           ActivityLog[]
  settings               Setting[]
  featureFlags           FeatureFlag[]
  aiUsageLogs            AIUsageLog[]

  @@map("customers")
}

// =============================================================================
// CORE: USER (DRIVER)
// =============================================================================

model User {
  id              String     @id @default(uuid()) @map("id")
  customerId      String     @map("customer_id")
  email           String?    @db.VarChar(255)
  phone           String     @db.VarChar(30)
  passwordHash    String?    @map("password_hash") @db.VarChar(255)
  pinHash         String?    @map("pin_hash") @db.VarChar(255)
  firstName       String     @map("first_name") @db.VarChar(100)
  lastName        String     @map("last_name") @db.VarChar(100)
  dateOfBirth     DateTime?  @map("date_of_birth")
  gender          String?    @db.VarChar(10)
  profilePhotoUrl String?    @map("profile_photo_url") @db.Text
  address         String?    @db.Text
  city            String?    @db.VarChar(100)
  emergencyContactName  String? @map("emergency_contact_name") @db.VarChar(200)
  emergencyContactPhone String? @map("emergency_contact_phone") @db.VarChar(30)
  status          UserStatus @default(PENDING) @map("status")
  kycStatus       KYCStatus  @default(NOT_STARTED) @map("kyc_status")
  creditScore     Int        @default(0) @map("credit_score")
  lastCreditScoreAt DateTime? @map("last_credit_score_at")
  referralCode    String?    @unique @map("referral_code") @db.VarChar(20)
  referredBy      String?    @map("referred_by") @db.VarChar(20)
  preferredLanguage String   @default("fr") @map("preferred_language") @db.VarChar(5)
  lastLoginAt     DateTime?  @map("last_login_at")
  emailVerifiedAt DateTime?  @map("email_verified_at")
  phoneVerifiedAt DateTime?  @map("phone_verified_at")
  metadata        Json?      @map("metadata")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  // Relations
  customer              Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kycDocuments          KYCDocument[]
  loans                 Loan[]
  payments              Payment[]
  vehicleRentals        VehicleRental[]
  rentToOwnContracts    RentToOwnContract[]
  accidentReports       AccidentReport[]
  creditScoreHistories  CreditScoreHistory[]
  incomeRecords         IncomeRecord[]
  supportTickets        SupportTicket[]
  notifications         Notification[]
  loginActivities       LoginActivity[]
  deviceTokens          DeviceToken[]
  pushSubscriptions     PushSubscription[]
  driverBadges          DriverBadge[]
  driverFavorites       DriverFavorite[]
  activityLogs          ActivityLog[]
  telemetryEvents       TelemetryEvent[]
  geofenceAlerts        GeofenceAlert[]
  aiExplanations        AIExplanation[]

  @@unique([customerId, email])
  @@unique([customerId, phone])
  @@index([customerId])
  @@index([status])
  @@index([kycStatus])
  @@index([creditScore])
  @@map("users")
}

// =============================================================================
// CORE: ADMIN
// =============================================================================

model Admin {
  id           String      @id @default(uuid()) @map("id")
  customerId   String      @map("customer_id")
  email        String      @db.VarChar(255)
  passwordHash String      @map("password_hash") @db.VarChar(255)
  firstName    String      @map("first_name") @db.VarChar(100)
  lastName     String      @map("last_name") @db.VarChar(100)
  role         AdminRole   @default(SUPPORT) @map("role")
  status       AdminStatus @default(ACTIVE) @map("status")
  avatarUrl    String?     @map("avatar_url") @db.Text
  phone        String?     @db.VarChar(30)
  lastLoginAt  DateTime?   @map("last_login_at")
  metadata     Json?       @map("metadata")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  // Relations
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kycReviews          KYCDocument[]        @relation("KYCReviewedBy")
  loanReviews         Loan[]               @relation("LoanReviewedBy")
  loanApprovals       Loan[]               @relation("LoanApprovedBy")
  rentalApprovals     VehicleRental[]      @relation("RentalApprovedBy")
  contractApprovals   RentToOwnContract[]  @relation("ContractApprovedBy")
  accidentAssignments AccidentReport[]     @relation("AccidentAssignedTo")
  accidentNotes       AccidentReportNote[]
  ticketAssignments   SupportTicket[]      @relation("TicketAssignedTo")
  ticketMessages      SupportTicketMessage[]
  loginActivities     LoginActivity[]
  activityLogs        ActivityLog[]
  adminPreference     AdminPreference?
  featureFlagAuditLogs FeatureFlagAuditLog[]

  @@unique([customerId, email])
  @@index([customerId])
  @@index([role])
  @@index([status])
  @@map("admins")
}

// =============================================================================
// KYC: DOCUMENTS
// =============================================================================

model KYCDocument {
  id           String         @id @default(uuid()) @map("id")
  customerId   String         @map("customer_id")
  userId       String         @map("user_id")
  type         DocumentType   @map("type")
  status       DocumentStatus @default(PENDING) @map("status")
  fileUrl      String         @map("file_url") @db.Text
  fileName     String         @map("file_name") @db.VarChar(255)
  fileSize     Int?           @map("file_size")
  mimeType     String?        @map("mime_type") @db.VarChar(100)
  documentNumber String?      @map("document_number") @db.VarChar(100)
  expiryDate   DateTime?      @map("expiry_date")
  rejectionReason String?     @map("rejection_reason") @db.Text
  reviewedById String?        @map("reviewed_by_id")
  reviewedAt   DateTime?      @map("reviewed_at")
  metadata     Json?          @map("metadata")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  // Relations
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy Admin?   @relation("KYCReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([userId])
  @@index([status])
  @@index([type])
  @@map("kyc_documents")
}

// =============================================================================
// VEHICLES
// =============================================================================

model Vehicle {
  id                  String        @id @default(uuid()) @map("id")
  customerId          String        @map("customer_id")
  make                String        @db.VarChar(100)
  model               String        @db.VarChar(100)
  year                Int           @map("year")
  color               String?       @db.VarChar(50)
  licensePlate        String        @map("license_plate") @db.VarChar(20)
  vin                 String?       @db.VarChar(50)
  fuelType            FuelType      @default(PETROL) @map("fuel_type")
  status              VehicleStatus @default(AVAILABLE) @map("status")
  mileage             Int           @default(0) @map("mileage")
  purchasePrice       Decimal?      @map("purchase_price") @db.Decimal(12, 2)
  currentValue        Decimal?      @map("current_value") @db.Decimal(12, 2)
  insuranceProvider   String?       @map("insurance_provider") @db.VarChar(200)
  insurancePolicyNumber String?     @map("insurance_policy_number") @db.VarChar(100)
  insuranceExpiryDate DateTime?     @map("insurance_expiry_date")
  gpsDeviceId         String?       @map("gps_device_id") @db.VarChar(100)
  gpsDeviceImei       String?       @map("gps_device_imei") @db.VarChar(20)
  lastLatitude        Float?        @map("last_latitude")
  lastLongitude       Float?        @map("last_longitude")
  lastLocationAt      DateTime?     @map("last_location_at")
  nextMaintenanceDate DateTime?     @map("next_maintenance_date")
  nextMaintenanceMileage Int?       @map("next_maintenance_mileage")
  photoUrl            String?       @map("photo_url") @db.Text
  notes               String?       @db.Text
  metadata            Json?         @map("metadata")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  // Relations
  customer             Customer                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicleRentals       VehicleRental[]
  rentToOwnContracts   RentToOwnContract[]
  accidentReports      AccidentReport[]
  maintenanceRecords   VehicleMaintenanceRecord[]
  telemetryEvents      TelemetryEvent[]
  driverFavorites      DriverFavorite[]

  @@unique([customerId, licensePlate])
  @@index([customerId])
  @@index([status])
  @@index([gpsDeviceId])
  @@map("vehicles")
}

// =============================================================================
// VEHICLE RENTAL
// =============================================================================

model VehicleRental {
  id              String       @id @default(uuid()) @map("id")
  customerId      String       @map("customer_id")
  userId          String       @map("user_id")
  vehicleId       String       @map("vehicle_id")
  status          RentalStatus @default(REQUESTED) @map("status")
  weeklyRate      Decimal      @map("weekly_rate") @db.Decimal(12, 2)
  depositAmount   Decimal      @default(0) @map("deposit_amount") @db.Decimal(12, 2)
  depositPaid     Boolean      @default(false) @map("deposit_paid")
  startDate       DateTime?    @map("start_date")
  endDate         DateTime?    @map("end_date")
  actualEndDate   DateTime?    @map("actual_end_date")
  approvedById    String?      @map("approved_by_id")
  approvedAt      DateTime?    @map("approved_at")
  terminationReason String?    @map("termination_reason") @db.Text
  notes           String?      @db.Text
  metadata        Json?        @map("metadata")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Relations
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  approvedBy Admin?   @relation("RentalApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([userId])
  @@index([vehicleId])
  @@index([status])
  @@map("vehicle_rentals")
}

// =============================================================================
// VEHICLE MAINTENANCE
// =============================================================================

model VehicleMaintenanceRecord {
  id              String          @id @default(uuid()) @map("id")
  vehicleId       String          @map("vehicle_id")
  type            MaintenanceType @map("type")
  description     String          @db.Text
  cost            Decimal?        @map("cost") @db.Decimal(12, 2)
  mileageAtService Int?           @map("mileage_at_service")
  serviceProvider String?         @map("service_provider") @db.VarChar(200)
  servicedAt      DateTime        @map("serviced_at")
  nextServiceDate DateTime?       @map("next_service_date")
  nextServiceMileage Int?         @map("next_service_mileage")
  notes           String?         @db.Text
  metadata        Json?           @map("metadata")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  // Relations
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([type])
  @@map("vehicle_maintenance_records")
}

// =============================================================================
// LOANS
// =============================================================================

model Loan {
  id                String     @id @default(uuid()) @map("id")
  customerId        String     @map("customer_id")
  userId            String     @map("user_id")
  loanNumber        String     @unique @map("loan_number") @db.VarChar(50)
  status            LoanStatus @default(DRAFT) @map("status")
  amount            Decimal    @map("amount") @db.Decimal(12, 2)
  interestRate      Decimal    @map("interest_rate") @db.Decimal(5, 2)
  totalRepayable    Decimal    @map("total_repayable") @db.Decimal(12, 2)
  amountPaid        Decimal    @default(0) @map("amount_paid") @db.Decimal(12, 2)
  outstandingBalance Decimal   @default(0) @map("outstanding_balance") @db.Decimal(12, 2)
  termWeeks         Int        @map("term_weeks")
  purpose           String?    @db.Text
  disbursedAt       DateTime?  @map("disbursed_at")
  dueDate           DateTime?  @map("due_date")
  completedAt       DateTime?  @map("completed_at")
  reviewedById      String?    @map("reviewed_by_id")
  reviewedAt        DateTime?  @map("reviewed_at")
  reviewNotes       String?    @map("review_notes") @db.Text
  approvedById      String?    @map("approved_by_id")
  approvedAt        DateTime?  @map("approved_at")
  rejectionReason   String?    @map("rejection_reason") @db.Text
  creditScoreAtApplication Int? @map("credit_score_at_application")
  metadata          Json?      @map("metadata")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  // Relations
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   Admin?         @relation("LoanReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedBy   Admin?         @relation("LoanApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  schedules    LoanSchedule[]
  payments     Payment[]

  @@index([customerId])
  @@index([userId])
  @@index([status])
  @@index([loanNumber])
  @@map("loans")
}

// =============================================================================
// LOAN SCHEDULE
// =============================================================================

model LoanSchedule {
  id             String         @id @default(uuid()) @map("id")
  loanId         String         @map("loan_id")
  weekNumber     Int            @map("week_number")
  dueDate        DateTime       @map("due_date")
  amountDue      Decimal        @map("amount_due") @db.Decimal(12, 2)
  amountPaid     Decimal        @default(0) @map("amount_paid") @db.Decimal(12, 2)
  status         ScheduleStatus @default(PENDING) @map("status")
  paidAt         DateTime?      @map("paid_at")
  lateFee        Decimal        @default(0) @map("late_fee") @db.Decimal(12, 2)
  notes          String?        @db.Text
  metadata       Json?          @map("metadata")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  // Relations
  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, weekNumber])
  @@index([loanId])
  @@index([status])
  @@index([dueDate])
  @@map("loan_schedules")
}

// =============================================================================
// PAYMENTS
// =============================================================================

model Payment {
  id                String        @id @default(uuid()) @map("id")
  customerId        String        @map("customer_id")
  userId            String        @map("user_id")
  loanId            String?       @map("loan_id")
  contractId        String?       @map("contract_id")
  paymentReference  String        @unique @map("payment_reference") @db.VarChar(100)
  type              PaymentType   @map("type")
  method            PaymentMethod @map("method")
  status            PaymentStatus @default(PENDING) @map("status")
  amount            Decimal       @map("amount") @db.Decimal(12, 2)
  fee               Decimal       @default(0) @map("fee") @db.Decimal(12, 2)
  netAmount         Decimal       @default(0) @map("net_amount") @db.Decimal(12, 2)
  currency          String        @default("XOF") @db.VarChar(3)
  providerReference String?       @map("provider_reference") @db.VarChar(255)
  providerName      String?       @map("provider_name") @db.VarChar(100)
  paidAt            DateTime?     @map("paid_at")
  failureReason     String?       @map("failure_reason") @db.Text
  description       String?       @db.Text
  metadata          Json?         @map("metadata")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  // Relations
  customer          Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  loan              Loan?              @relation(fields: [loanId], references: [id], onDelete: SetNull)
  rentToOwnContract RentToOwnContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([userId])
  @@index([loanId])
  @@index([contractId])
  @@index([status])
  @@index([type])
  @@index([paymentReference])
  @@map("payments")
}

// =============================================================================
// RENT-TO-OWN: CONTRACT
// =============================================================================

model RentToOwnContract {
  id                String         @id @default(uuid()) @map("id")
  customerId        String         @map("customer_id")
  userId            String         @map("user_id")
  vehicleId         String         @map("vehicle_id")
  contractNumber    String         @unique @map("contract_number") @db.VarChar(50)
  status            ContractStatus @default(DRAFT) @map("status")
  vehiclePrice      Decimal        @map("vehicle_price") @db.Decimal(12, 2)
  downPayment       Decimal        @default(0) @map("down_payment") @db.Decimal(12, 2)
  totalAmount       Decimal        @map("total_amount") @db.Decimal(12, 2)
  weeklyPayment     Decimal        @map("weekly_payment") @db.Decimal(12, 2)
  totalWeeks        Int            @default(156) @map("total_weeks")
  weeksCompleted    Int            @default(0) @map("weeks_completed")
  amountPaid        Decimal        @default(0) @map("amount_paid") @db.Decimal(12, 2)
  outstandingBalance Decimal       @default(0) @map("outstanding_balance") @db.Decimal(12, 2)
  ownershipPercentage Decimal      @default(0) @map("ownership_percentage") @db.Decimal(5, 2)
  startDate         DateTime?      @map("start_date")
  expectedEndDate   DateTime?      @map("expected_end_date")
  actualEndDate     DateTime?      @map("actual_end_date")
  approvedById      String?        @map("approved_by_id")
  approvedAt        DateTime?      @map("approved_at")
  terminationReason String?        @map("termination_reason") @db.Text
  notes             String?        @db.Text
