{
  "name": "damflotte-cld",
  "version": "2.0.0",
  "description": "DAMFlotte CLD - Enterprise Fleet Management & Driver Credit Scoring Platform",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:admin\"",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:admin": "npm run dev --workspace=apps/admin-web",
    "build": "npm run build:api && npm run build:admin",
    "build:api": "npm run build --workspace=apps/api",
    "build:admin": "npm run build --workspace=apps/admin-web",
    "test": "npm run test --workspace=apps/api",
    "lint": "eslint 'apps/*/src/**/*.{ts,tsx}' --fix",
    "format": "prettier --write 'apps/*/src/**/*.{ts,tsx}'",
    "db:migrate": "npm run migrate --workspace=packages/database",
    "db:generate": "npm run generate --workspace=packages/database",
    "db:seed": "npm run seed --workspace=apps/api",
    "db:studio": "npm run studio --workspace=packages/database"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4"
  },
  "engines": { "node": ">=18.0.0" }
}
